# Kicktipp-Runde: der Teil der URL nach kicktipp.de/, z. B. https://www.kicktipp.de/meine-runde/ -> meine-runde
KICKTIPP_SLUG=

# Optional: Login eines Mitglieds der Runde, nur für die Wettquoten nötig (ohne bleiben die Quoten leer)
KICKTIPP_EMAIL=
KICKTIPP_PASSWORD=

# Optional: Basic Auth für die Seite (leer = ohne Passwortschutz, z. B. hinter einem Reverse Proxy)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: Port im Container (Standard 8080) und Stunde (Berliner Zeit) der täglichen Komplettaktualisierung (Standard 6)
# PORT=8080
# ODDS_HOUR=6
